{
  "manifest_version": 3,
  "name": "Walk Of Life \u2014 Apple Music Bridge",
  "version": "1.7.0",
  "description": "Connects the Walk Of Life GitHub Pages player to the Music app on this Mac.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://81u3ch3rry-glitch.github.io/walk-of-life/*",
    "https://itunes.apple.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://81u3ch3rry-glitch.github.io/walk-of-life/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Walk Of Life Apple Music Bridge",
    "default_popup": "popup.html"
  }
}
